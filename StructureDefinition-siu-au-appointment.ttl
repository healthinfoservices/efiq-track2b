  fhir:StructureDefinition.description [ fhir:value "An Appointment created and maintained from HL7 v2 SIU S12, S13, S14 and S15 messages,\nwhose participants are AU Core resources. The ingestion service rebuilds the whole\nresource from each message it applies."] ;
